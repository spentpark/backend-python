# Configuración de la aplicación
# Entorno de ejecución: development | production.
# En producción el arranque falla cerrado si faltan JWT_SECRET o
# AUTH_PASSWORD_HASH, y Swagger queda deshabilitado salvo API_DOCS_ENABLED=true.
ENVIRONMENT=development

# Configuración de base de datos (MySQL / MariaDB)
DB_HOST=200.83.105.123
DB_USER=admin
DB_PASSWORD=password
DB_NAME=game
DB_PORT=3306

# Puerto e interfaz del servidor
# La aplicación escucha en 7000 (backend Node usa 3000; no deben colisionar).
PORT=7000
HOST=0.0.0.0

# ─── CORS y proxy ──────────────────────────────────────────────────────────
# Orígenes permitidos, separados por comas. Vacío = allowlist por defecto de
# app/main.py (frontend React en localhost/127.0.0.1:5173, :4173 y :8065, sus
# equivalentes en 192.168.1.82 y 200.83.105.123, y el frontend Angular legacy
# en :4200/:4300). En desarrollo además se acepta cualquier
# http://localhost[:puerto] y http://127.0.0.1[:puerto].
# CORS_ORIGINS=http://localhost:5173,http://localhost:8065,https://tudominio.com
# true si hay un proxy inverso de confianza delante (rate limiting por IP real).
TRUST_PROXY=false

# ─── Rate limiting ─────────────────────────────────────────────────────────
# Límite global de la API por IP (por defecto 300 peticiones / 15 min).
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
# Límite de intentos de login por IP (por defecto 5 / 15 min).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# ─── Autenticación JWT (compartida con backend-node20/rss-game-node) ────────
# Mismo secreto, issuer y audience que Node: un token emitido por cualquiera de
# los servicios es válido en el otro. Así el frontend puede reutilizar el token.
# Genera el secreto con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=7456dd0b8487a4477dd5ef9078d8f9c264f82301e034f669bffa31e2b7dfe0d8
JWT_EXPIRES_IN=1h
JWT_ISSUER=rss-game-node
JWT_AUDIENCE=rss-game-node-api
AUTH_USERNAME=admin
AUTH_ROLE=admin
# Hash bcrypt de la contraseña de desarrollo compartida con rss-game-node.
# Credenciales de desarrollo: admin / Dev-aekiu4-9mHsG
AUTH_PASSWORD_HASH=$2b$12$21YmeGUU8ULL3ngZm3btLeSMswy9oOBQNXhQAdrvGTLGKP1zClT32

# ─── Documentación OpenAPI ─────────────────────────────────────────────────
# Swagger UI en /api-docs (en producción: solo si se pone true).
API_DOCS_ENABLED=true
